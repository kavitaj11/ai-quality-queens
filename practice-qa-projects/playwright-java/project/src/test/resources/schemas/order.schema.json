{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Order",
  "type": "object",
  "required": ["orderId", "status", "username", "currency", "total", "createdAt", "lines"],
  "additionalProperties": false,
  "properties": {
    "orderId":   { "type": "string", "pattern": "^ORD-[0-9A-F]{8}$" },
    "status":    { "enum": ["CONFIRMED", "CANCELLED"] },
    "username":  { "type": "string", "minLength": 1 },
    "currency":  { "type": "string", "pattern": "^[A-Z]{3}$" },
    "total":     { "type": "number", "exclusiveMinimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["productId", "name", "quantity", "unitPrice", "lineTotal"],
        "additionalProperties": false,
        "properties": {
          "productId": { "type": "integer" },
          "name":      { "type": "string", "minLength": 1 },
          "quantity":  { "type": "integer", "minimum": 1, "maximum": 5 },
          "unitPrice": { "type": "number", "exclusiveMinimum": 0 },
          "lineTotal": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
